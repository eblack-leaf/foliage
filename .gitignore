target
.idea
/application/dist/
/foliage/book/dist/

# repo-local Android SDK + the exports that point at it, both set up by
# application/android/README.md's "One-time environment setup" -- multi-GB tooling, not source.
/.android-sdk/
/android-env.sh

# android/ is generated by `foliage_android gen` (see application/android/README.md) --
# everything gradle/cargo-ndk produce under it is a build artifact, not source.
/application/android/.gradle/
/application/android/local.properties
/application/android/app/build/
/application/android/app/src/main/jniLibs/
# release-signing secrets -- never committed, see android/README.md's "Release signing"
/application/android/keystore.properties
/application/android/*.keystore
/application/android/*.jks
